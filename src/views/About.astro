---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSupportUrl } from '../lib/support';
import { listPublicSources, loadSourceConfigs } from '../lib/sources';
import { localePath } from '../lib/site-url';
import { aboutMeta, aboutSections } from '../i18n/about';
import { t, type Locale } from '../i18n/ui';

const locale = Astro.currentLocale as Locale;
const supportUrl = getSupportUrl();
const copy = aboutSections(locale);
const meta = aboutMeta(locale);
const sources = listPublicSources(loadSourceConfigs());
const disclaimerHref = localePath(locale, 'disclaimer/');

function categoryLabel(categories: ('automotive' | 'product')[]): string {
  return categories
    .map((c) => (c === 'automotive' ? copy.categoryAutomotive : copy.categoryProduct))
    .join(' / ');
}
---

<BaseLayout title={meta.title} description={meta.description} path="about/">
  <h1 style="font-size: 1.25rem; margin-bottom: 1rem">{t(locale, 'aboutTitle')}</h1>
  <div class="about-prose">
    {copy.intro.map((p) => <p set:html={p} />)}
    <h2>{copy.sourcesTitle}</h2>
    <p set:html={copy.sourcesLead} />
    <ul class="about-source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.homepage} target="_blank" rel="noopener noreferrer">
              {source.name}
            </a>
            <span class="about-source-cat">{categoryLabel(source.categories)}</span>
          </li>
        ))
      }
    </ul>
    <p>
      {copy.sourcesNote}{' '}
      <a href={disclaimerHref}>{copy.disclaimerLink}</a>
    </p>
    <h2>{copy.supportTitle}</h2>
    {copy.supportBody.map((p) => <p set:html={p} />)}
    {
      supportUrl ? (
        <p>
          <a href={supportUrl} target="_blank" rel="noopener noreferrer">
            {copy.supportLink}
          </a>
          {copy.supportExternal}
        </p>
      ) : (
        <p class="about-muted">{copy.supportPending}</p>
      )
    }
    <h2>{copy.feedbackTitle}</h2>
    <p>{copy.feedbackBody}</p>
  </div>
</BaseLayout>
